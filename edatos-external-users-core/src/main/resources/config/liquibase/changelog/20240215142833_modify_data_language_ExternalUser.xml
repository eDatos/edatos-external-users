<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.9.xsd">

    <!-- Cambiar los valores de 'language' en 'tb_external_users' según los codes proporcionados -->
    <changeSet id="20240215142833-1" author="arte">
        <update tableName="tb_external_users">
            <column name="language" value="es"/>
            <where>language = 'SPANISH'</where>
        </update>
        <update tableName="tb_external_users">
            <column name="language" value="ca"/>
            <where>language = 'CATALAN'</where>
        </update>
        <update tableName="tb_external_users">
            <column name="language" value="en"/>
            <where>language = 'ENGLISH'</where>
        </update>
    </changeSet>
</databaseChangeLog>
